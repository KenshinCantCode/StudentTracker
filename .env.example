# Copy to .env.local and set unique values.
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=kenshin091306
SQLITE_PATH=data/dutytrack.sqlite

# Brand shown in the logo: <BRAND_A><BRAND_B>
NEXT_PUBLIC_BRAND_A=Duty
NEXT_PUBLIC_BRAND_B=Track

# Time zone (Philippines = UTC+8, no daylight saving)
TZ_NAME=Asia/Manila
TZ_OFFSET_MIN=480

# Used by the kiosk clock in the browser (keep equal to TZ_NAME)
NEXT_PUBLIC_TZ_NAME=Asia/Manila

# Set to true only when serving over HTTPS. Keep false for local HTTP.
COOKIE_SECURE=false
