# Copy to .env.local and edit.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true

# Brand shown in the logo: <BRAND_A><BRAND_B>
NEXT_PUBLIC_BRAND_A=Duty
NEXT_PUBLIC_BRAND_B=Track

# Time zone (Philippines = UTC+8, no daylight saving)
TZ_NAME=Asia/Manila
TZ_OFFSET_MIN=480

# Used by the kiosk clock in the browser (keep equal to TZ_NAME)
NEXT_PUBLIC_TZ_NAME=Asia/Manila

# Set to true when serving over HTTPS (including Vercel).
COOKIE_SECURE=true
